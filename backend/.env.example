APP_NAME=PrecoMobi API
APP_ENV=development
API_PREFIX=/api
# A API será executada dentro de backend; o banco fica em data/precomobi.db
DATABASE_URL=sqlite:///../data/precomobi.db
# PostgreSQL futuro:
# DATABASE_URL=postgresql+psycopg://precomobi:senha@localhost:5432/precomobi
CORS_ORIGINS=http://localhost:5173

# E-mail de boas-vindas ao cadastrar (opcional). Deixe em branco para não enviar e-mail.
# Exemplo usando Gmail: crie uma Senha de App em myaccount.google.com/apppasswords
# (precisa de verificação em 2 etapas ativada na conta) e cole aqui, SEM ESPAÇOS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seuemail@gmail.com
# SMTP_PASSWORD=senha-de-app-de-16-letras
# EMAIL_FROM=PreçoMobi <seuemail@gmail.com>

# Confirmação e boas-vindas por API HTTPS gratuita Brevo (obrigatórios para novos cadastros)
FRONTEND_URL=http://localhost:5173
BREVO_API_KEY=
# EMAIL_FROM deve ser um remetente verificado no painel Brevo
EMAIL_FROM=contato@seu-dominio.com

# Preencha com o mesmo projeto Supabase usado no frontend
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_SUPABASE

# Ative apenas para a apresentação acadêmica; cria dados de exemplo identificados.
DEMO_MODE=false
# Em produção: APP_ENV=production, PostgreSQL e chave própria longa.
SECRET_KEY=precomobi-dev-secret-troque-em-producao

# Ao usar o PostgreSQL do Supabase, mantenha as tabelas fora do schema público.
# Crie e migre esse schema com scripts/migrate_catalog.py antes de iniciar a API.
APP_DB_SCHEMA=
